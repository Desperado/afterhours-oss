diff --git a/libs/surfaces/mcp_http/README.md b/libs/surfaces/mcp_http/README.md
index 646c5ad1c..05b1d0e7c 100644
--- a/libs/surfaces/mcp_http/README.md
+++ b/libs/surfaces/mcp_http/README.md
@@ -26,6 +26,14 @@ This is an experimental surface intended for early real-world testing and feedba
 
 The server applies port changes immediately after committing the setting.
 
+### AFTERHOURS fork
+
+This fork binds MCP HTTP only to IPv4 loopback (`127.0.0.1`). Requests must
+have a `127.0.0.1:<port>` or `localhost:<port>` Host, no Origin, and JSON
+content type. Bodies are limited to 2 MiB. Browser controls go through the
+AFTERHOURS local backend; direct browser requests are rejected. Keep this
+experimental control surface disabled until you need local control.
+
 ## Transport and Naming
 
 - Transport is HTTP (streamable MCP endpoint), not SSE.
diff --git a/libs/surfaces/mcp_http/local_http_policy.h b/libs/surfaces/mcp_http/local_http_policy.h
new file mode 100644
index 000000000..7a5eb7f7a
--- /dev/null
+++ b/libs/surfaces/mcp_http/local_http_policy.h
@@ -0,0 +1,25 @@
+/* AFTERHOURS local control policy. SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef AFTERHOURS_LOCAL_HTTP_POLICY_H
+#define AFTERHOURS_LOCAL_HTTP_POLICY_H
+
+#include <cstdint>
+#include <string>
+
+namespace ArdourMCP {
+
+// The web UI uses its own same-origin backend. Native clients send no Origin.
+inline bool local_request_allowed (const std::string& host, int origin_size, uint16_t port)
+{
+	const std::string suffix = ":" + std::to_string (port);
+	return origin_size == 0 && (host == "127.0.0.1" + suffix || host == "localhost" + suffix);
+}
+
+inline bool json_content_type (const std::string& value)
+{
+	const size_t end = value.find (';');
+	return value.substr (0, end) == "application/json";
+}
+
+static const size_t max_request_bytes = 2 * 1024 * 1024;
+}
+#endif
diff --git a/libs/surfaces/mcp_http/local_http_policy_test.cc b/libs/surfaces/mcp_http/local_http_policy_test.cc
new file mode 100644
index 000000000..a75bc6fa3
--- /dev/null
+++ b/libs/surfaces/mcp_http/local_http_policy_test.cc
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "local_http_policy.h"
+#include <cassert>
+
+int main ()
+{
+	using namespace ArdourMCP;
+	assert (local_request_allowed ("127.0.0.1:4820", 0, 4820));
+	assert (local_request_allowed ("localhost:9000", 0, 9000));
+	assert (!local_request_allowed ("127.0.0.1:4820", 23, 4820));
+	assert (!local_request_allowed ("127.0.0.1:4820", -1, 4820));
+	assert (!local_request_allowed ("evil.example:4820", 0, 4820));
+	assert (!local_request_allowed ("127.0.0.1.evil.example:4820", 0, 4820));
+	assert (!local_request_allowed ("127.0.0.1:4821", 0, 4820));
+	assert (!local_request_allowed ("", 0, 4820));
+	assert (json_content_type ("application/json"));
+	assert (json_content_type ("application/json; charset=utf-8"));
+	assert (!json_content_type ("text/plain"));
+	assert (!json_content_type ("application/json-evil"));
+}
