+
 	char        uri[1024];
 	std::string path;
 
@@ -3162,6 +3173,10 @@ MCPHttpServer::handle_http (struct lws* wsi, ClientContext& ctx)
 		path = uri;
 
 		if (path == "/mcp") {
+			char content_type[128] = {};
+			if (lws_hdr_copy (wsi, content_type, sizeof (content_type), WSI_TOKEN_HTTP_CONTENT_TYPE) <= 0 || !ArdourMCP::json_content_type (content_type)) {
+				return send_http_status (wsi, 415);
+			}
 			ctx.mcp_post = true;
 			return 0;
 		}
@@ -3173,12 +3188,17 @@ MCPHttpServer::handle_http (struct lws* wsi, ClientContext& ctx)
 }
 
 int
-MCPHttpServer::handle_http_body (struct lws* /*wsi*/, ClientContext& ctx, void* in, size_t len)
+MCPHttpServer::handle_http_body (struct lws* wsi, ClientContext& ctx, void* in, size_t len)
 {
 	if (!ctx.mcp_post) {
 		return 0;
 	}
 
+	if (len > ArdourMCP::max_request_bytes - ctx.request_body.size ()) {
+		ctx.mcp_post = false;
+		ctx.request_body.clear ();
+		return send_http_status (wsi, 413);
+	}
 	ctx.request_body.append (static_cast<char*> (in), len);
 	return 0;
 }
