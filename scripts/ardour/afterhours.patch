@@ -3144,6 +3147,14 @@ MCPHttpServer::handle_http (struct lws* wsi, ClientContext& ctx)
 	ctx.request_body.clear ();
 	ctx.response_body.clear ();
 
+	char host[256] = {};
+	const int host_len = lws_hdr_copy (wsi, host, sizeof (host), WSI_TOKEN_HOST);
+	const int origin_len = lws_hdr_total_length (wsi, WSI_TOKEN_ORIGIN);
+	// Reject every browser Origin, including oversized headers and "null".
+	if (host_len <= 0 || !ArdourMCP::local_request_allowed (host, origin_len, _port)) {
+		return send_http_status (wsi, 403);
